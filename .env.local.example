# 이 파일을 복사해서 .env.local 로 이름을 바꾸고 값을 채우세요. (Vercel은 Settings → Environment Variables)
# 모두 선택 사항입니다. 비워 두면: 기록은 브라우저에 저장, 문장 해석은 규칙 기반으로 동작합니다.

# Supabase (대시보드 → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Claude API (문장 해석을 Claude로) — 실패해도 규칙 기반으로 자동 전환
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-5-5
